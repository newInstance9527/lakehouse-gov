[
  {
    "name": "LhTableDaysToFullP95Below45",
    "note": "表级 days-to-full(p95)<45；route=owner",
    "severity": 1,
    "disabled": 0,
    "prom_for_duration": 1800,
    "prom_ql": "lh_table_storage_days_to_full{quantile=\"p95\"} < 45 and lh_table_storage_days_to_full{quantile=\"p95\"} > 0",
    "prom_eval_interval": 60,
    "enable_stime": "00:00",
    "enable_etime": "23:59",
    "enable_days_of_week": ["0", "1", "2", "3", "4", "5", "6"],
    "enable_in_bg": 0,
    "notify_recovered": 1,
    "notify_channels": [],
    "notify_repeat_step": 60,
    "recover_duration": 0,
    "callbacks": [],
    "runbook_url": "",
    "append_tags": ["domain=storage", "route=owner", "severity=critical"],
    "annotations": {
      "summary": "表 {{$labels.fqtn}} days-to-full(p95)={{$value}}d < 45 · owner={{$labels.owner}}",
      "description": "C2 分段线性写回 VM。认责 {{$labels.owner}}（unassigned→平台组）。深链 /lifecycle/storage?fqtn={{$labels.fqtn}}"
    }
  },
  {
    "name": "LhBucketDaysToFullBelow45",
    "note": "桶估算 TTF<45d；(cap-used)/7d日均增量",
    "severity": 1,
    "disabled": 0,
    "prom_for_duration": 3600,
    "prom_ql": "((lh_bucket_storage_capacity_bytes - on(bucket) lh_bucket_storage_used_bytes) / on(bucket) clamp_min((lh_bucket_storage_used_bytes - lh_bucket_storage_used_bytes offset 7d) / 7, 1)) < 45 and on(bucket) (lh_bucket_storage_used_bytes - lh_bucket_storage_used_bytes offset 7d) > 0",
    "prom_eval_interval": 60,
    "enable_stime": "00:00",
    "enable_etime": "23:59",
    "enable_days_of_week": ["0", "1", "2", "3", "4", "5", "6"],
    "enable_in_bg": 0,
    "notify_recovered": 1,
    "notify_channels": [],
    "notify_repeat_step": 60,
    "recover_duration": 0,
    "callbacks": [],
    "runbook_url": "",
    "append_tags": ["domain=storage", "route=platform", "severity=critical"],
    "annotations": {
      "summary": "桶 {{$labels.bucket}} 估算 TTF < 45d",
      "description": "需 capacity；深链 /lifecycle/storage?bucket={{$labels.bucket}}"
    }
  },
  {
    "name": "LhBucketUsageOver80Pct",
    "note": "桶水位 used/capacity≥80%",
    "severity": 2,
    "disabled": 0,
    "prom_for_duration": 1800,
    "prom_ql": "(lh_bucket_storage_used_bytes / on(bucket) lh_bucket_storage_capacity_bytes) >= 0.8",
    "prom_eval_interval": 60,
    "enable_stime": "00:00",
    "enable_etime": "23:59",
    "enable_days_of_week": ["0", "1", "2", "3", "4", "5", "6"],
    "enable_in_bg": 0,
    "notify_recovered": 1,
    "notify_channels": [],
    "notify_repeat_step": 60,
    "recover_duration": 0,
    "callbacks": [],
    "runbook_url": "",
    "append_tags": ["domain=storage", "route=platform", "severity=warning"],
    "annotations": {
      "summary": "桶 {{$labels.bucket}} 用量占比 ≥ 80%",
      "description": "生命周期桶水位；与 lh_bucket_storage_* 同源"
    }
  },
  {
    "name": "LhWorkspaceStorageQuotaOver80Pct",
