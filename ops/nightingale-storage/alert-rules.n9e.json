    "enable_etime": "23:59",
    "enable_days_of_week": ["0", "1", "2", "3", "4", "5", "6"],
    "enable_in_bg": 0,
    "notify_recovered": 1,
    "notify_channels": [],
    "notify_repeat_step": 60,
    "recover_duration": 0,
    "callbacks": [],
    "runbook_url": "",
