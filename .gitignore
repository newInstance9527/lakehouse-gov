# 临时排查/运维脚本统一归档目录（勿提交内容）
# 约定：一次性探测、连库检查、手工 curl 封装等一律放 tmp/scripts/
tmp/

# 误落在仓库根目录的临时脚本（兜底忽略）
/_check_*.py
/_check_*.sh
/_check_*.ps1
/_tmp_*.*
/_scratch_*.*
/adhoc_*.*
!**/src/main/resources/lib/*.jar
!**/allatori/**
.cursor/

# 禁止提交本机 Maven 路径。.mvn/maven.config 会被拼进所有人的 mvn 命令行，
# 写 -s / maven.repo.local 等个人盘符会直接导致 Error executing Maven。
.mvn/maven.config

# 本机密钥（spring.profiles.active=local 覆盖）；仅提交 *.example
**/application-local.properties
**/application-secrets.properties
**/application-*-secrets.properties
**/application-*.local.properties
!**/application-local.properties.example
ops/trino-federation/catalog/clickhouse.properties
ops/trino-federation/catalog/ck.properties
!ops/trino-federation/catalog/*.properties.example
